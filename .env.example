# Copy to .env and adjust. Used by docker compose and by the application (as environment variables).
DB_URL=jdbc:postgresql://localhost:5432/usermanagement
DB_USERNAME=usermanagement
DB_PASSWORD=usermanagement

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin-Passw0rd

# Domain configuration (user types, roles, attribute schemas)
APP_DOMAIN_CONFIG=./config/examples/logistics.yml
APP_NAME=Acme Logistics

# Tokens (required with SPRING_PROFILES_ACTIVE=prod)
JWT_ISSUER=https://auth.example.com
JWT_PRIVATE_KEY=file:./secrets/jwt-private.pem
JWT_PUBLIC_KEY=file:./secrets/jwt-public.pem

# Email (omit SPRING_MAIL_HOST to log emails instead of sending them)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
MAIL_FROM=no-reply@example.com

# Events webhook (optional)
# APP_EVENTS_WEBHOOK_URL=https://example.com/hooks/users
# APP_EVENTS_WEBHOOK_SECRET=change-me

# Browser clients allowed to call the API (comma separated)
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Activity (audit) log and domain events to Kafka
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# KAFKA_TOPIC_AUDIT=user-management.audit
# KAFKA_TOPIC_DOMAIN_EVENTS=user-management.domain-events
# AUDIT_ENABLED=true
